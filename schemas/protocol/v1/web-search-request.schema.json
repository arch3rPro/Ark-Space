{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "web.search"
    },
    "input": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "maxResults": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "timeoutMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "provider": {
          "type": "string",
          "enum": [
            "exa",
            "tavily",
            "firecrawl",
            "local",
            "searxng"
          ]
        },
        "includeDomains": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "excludeDomains": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "options": {
          "type": "object",
          "properties": {
            "searxng": {
              "type": "object",
              "properties": {
                "categories": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_ -]{1,50}$"
                  }
                },
                "engines": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_ -]{1,50}$"
                  }
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,30}$"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "safesearch": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 0
                    },
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    }
                  ]
                },
                "timeRange": {
                  "type": "string",
                  "enum": [
                    "day",
                    "month",
                    "year"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "query",
        "maxResults",
        "timeoutMs",
        "includeDomains",
        "excludeDomains"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
