{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "web.related"
    },
    "input": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 4096,
          "format": "uri"
        },
        "maxResults": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "timeoutMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "includeDomains": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "excludeDomains": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          }
        },
        "provider": {
          "type": "string",
          "enum": [
            "exa"
          ]
        }
      },
      "required": [
        "url",
        "maxResults",
        "timeoutMs",
        "includeDomains",
        "excludeDomains"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
