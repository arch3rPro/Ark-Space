{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "x.search"
    },
    "input": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "boolean",
          "const": true
        },
        "timeoutMs": {
          "default": 20000,
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "query": {
          "default": "",
          "type": "string",
          "maxLength": 500
        },
        "from": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{1,15}$"
          }
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "minLikes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        },
        "mode": {
          "default": "latest",
          "type": "string",
          "enum": [
            "latest",
            "top",
            "media"
          ]
        },
        "filter": {
          "type": "string",
          "enum": [
            "media",
            "images",
            "videos",
            "links",
            "news",
            "quote",
            "mentions",
            "replies"
          ]
        },
        "includeRetweets": {
          "default": false,
          "type": "boolean"
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "confirmed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
