{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "usegpt.handoff.complete"
    },
    "input": {
      "type": "object",
      "properties": {
        "handoffId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "claimToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "handoffId",
        "claimToken",
        "generation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
