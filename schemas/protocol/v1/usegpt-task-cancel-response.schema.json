{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "capability": {
      "type": "string",
      "enum": [
        "usegpt.connection.status",
        "usegpt.task.start",
        "usegpt.task.get",
        "usegpt.task.list",
        "usegpt.task.wait",
        "usegpt.task.follow_up",
        "usegpt.task.cancel",
        "usegpt.artifact.get"
      ]
    },
    "connection": {
      "type": "string",
      "const": "usegpt"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 80
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "protocolVersion",
    "ok",
    "capability",
    "connection",
    "warnings"
  ],
  "additionalProperties": false
}
