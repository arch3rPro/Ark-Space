{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "monitor.list"
    },
    "input": {
      "type": "object",
      "properties": {
        "limit": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
