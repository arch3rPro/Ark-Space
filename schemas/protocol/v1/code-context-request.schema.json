{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "code.context"
    },
    "input": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "tokens": {
          "default": "dynamic",
          "anyOf": [
            {
              "type": "string",
              "const": "dynamic"
            },
            {
              "type": "integer",
              "minimum": 1000,
              "maximum": 50000
            }
          ]
        },
        "timeoutMs": {
          "default": 60000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "provider": {
          "type": "string",
          "enum": [
            "exa"
          ]
        }
      },
      "required": [
        "query",
        "tokens",
        "timeoutMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
