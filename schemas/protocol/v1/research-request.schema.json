{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "research.run"
    },
    "input": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "depth": {
          "default": "standard",
          "type": "string",
          "enum": [
            "concise",
            "standard",
            "deep"
          ]
        },
        "timeoutMs": {
          "default": 600000,
          "type": "integer",
          "minimum": 10000,
          "maximum": 1800000
        },
        "provider": {
          "type": "string",
          "enum": [
            "exa",
            "tavily"
          ]
        }
      },
      "required": [
        "prompt",
        "depth",
        "timeoutMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
