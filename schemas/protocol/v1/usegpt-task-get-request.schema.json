{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "usegpt.task.get"
    },
    "input": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^ugpt_[a-f0-9-]{36}$"
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
