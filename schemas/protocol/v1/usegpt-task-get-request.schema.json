{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "usegpt.task.get"
    },
    "input": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "eventCursor": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
