{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "monitor.site.create"
    },
    "input": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "cron"
                },
                "value": {
                  "type": "string",
                  "minLength": 9,
                  "maxLength": 100
                },
                "timezone": {
                  "default": "UTC",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "type",
                "value",
                "timezone"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "text"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "timezone": {
                  "default": "UTC",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "type",
                "value",
                "timezone"
              ],
              "additionalProperties": false
            }
          ]
        },
        "targets": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "scrape"
                  },
                  "urls": {
                    "minItems": 1,
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096,
                      "format": "uri"
                    }
                  },
                  "onlyMainContent": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "urls",
                  "onlyMainContent"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "crawl"
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 4096,
                    "format": "uri"
                  },
                  "limit": {
                    "default": 20,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "maxDepth": {
                    "default": 2,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "includePaths": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "excludePaths": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "onlyMainContent": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "url",
                  "limit",
                  "maxDepth",
                  "includePaths",
                  "excludePaths",
                  "onlyMainContent"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "search"
                  },
                  "queries": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "searchWindow": {
                    "default": "24h",
                    "type": "string",
                    "enum": [
                      "5m",
                      "15m",
                      "1h",
                      "6h",
                      "24h",
                      "7d"
                    ]
                  },
                  "maxResults": {
                    "default": 10,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "includeDomains": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    }
                  },
                  "excludeDomains": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253
                    }
                  }
                },
                "required": [
                  "type",
                  "queries",
                  "searchWindow",
                  "maxResults",
                  "includeDomains",
                  "excludeDomains"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "retentionDays": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "judgeEnabled": {
          "default": false,
          "type": "boolean"
        },
        "webhookUrl": {
          "type": "string",
          "maxLength": 4096,
          "format": "uri"
        },
        "webhookEvents": {
          "default": [
            "monitor.page",
            "monitor.check.completed"
          ],
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monitor.page",
              "monitor.check.completed"
            ]
          }
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        },
        "timeoutMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      },
      "required": [
        "name",
        "schedule",
        "targets",
        "retentionDays",
        "judgeEnabled",
        "webhookEvents",
        "confirmed",
        "timeoutMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
