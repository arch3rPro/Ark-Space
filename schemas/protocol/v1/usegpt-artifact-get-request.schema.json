{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "usegpt.artifact.get"
    },
    "input": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^ugpt_[a-f0-9-]{36}$"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 20000,
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "taskId",
        "artifactId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
