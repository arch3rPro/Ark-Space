{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "x.user"
    },
    "input": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "boolean",
          "const": true
        },
        "timeoutMs": {
          "default": 20000,
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "username": {
          "type": "string",
          "pattern": "^@?[A-Za-z0-9_]{1,15}$"
        },
        "includeAbout": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "confirmed",
        "username"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
