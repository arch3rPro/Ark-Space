{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "browser.interact"
    },
    "input": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "navigate"
                },
                "url": {
                  "type": "string",
                  "maxLength": 4096,
                  "format": "uri"
                }
              },
              "required": [
                "type",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "click"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^@e[1-9]\\d{0,5}$"
                }
              },
              "required": [
                "type",
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "fill"
                },
                "ref": {
                  "type": "string",
                  "pattern": "^@e[1-9]\\d{0,5}$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 8000
                }
              },
              "required": [
                "type",
                "ref",
                "text"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "press"
                },
                "key": {
                  "type": "string",
                  "enum": [
                    "Enter",
                    "Tab",
                    "Escape",
                    "ArrowUp",
                    "ArrowDown",
                    "ArrowLeft",
                    "ArrowRight",
                    "Backspace",
                    "Delete",
                    "Space"
                  ]
                }
              },
              "required": [
                "type",
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "scroll"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "up",
                    "down"
                  ]
                },
                "pixels": {
                  "default": 500,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "type",
                "direction",
                "pixels"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "scrape"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          ]
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        },
        "timeoutMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        }
      },
      "required": [
        "sessionId",
        "action",
        "confirmed",
        "timeoutMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
