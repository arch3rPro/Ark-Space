{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "capability": {
      "type": "string",
      "const": "usegpt.task.follow_up"
    },
    "input": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "mode": {
          "default": "chat",
          "type": "string",
          "enum": [
            "chat",
            "search",
            "deep-research",
            "image"
          ]
        },
        "timeoutMs": {
          "default": 1200000,
          "type": "integer",
          "minimum": 10000,
          "maximum": 3600000
        },
        "files": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "content": {
                "type": "string",
                "maxLength": 200000
              }
            },
            "required": [
              "name",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "confirmed": {
          "type": "boolean",
          "const": true
        },
        "taskId": {
          "type": "string",
          "pattern": "^ugpt_[a-f0-9-]{36}$"
        }
      },
      "required": [
        "requestId",
        "prompt",
        "confirmed",
        "taskId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "capability",
    "input"
  ],
  "additionalProperties": false
}
